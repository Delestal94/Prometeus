# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Exported game builds (binaries, not source -- regenerate via export_presets.cfg)
/builds/

# Blender auto-backup files
*.blend1

# Godot-generated translation files
*.translation

# Imported/compiled binaries
*.import

# Mono/C# specific
.mono/
data_*/
mono_crash.*.json

# OS/editor clutter
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/

# Claude Code: agentes, skills, hooks y settings.json son del proyecto y se
# versionan; lo personal de cada uno (settings.local.json) y lo que genera la
# herramienta en cada sesión, no.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
.codex/

# Godot's native-library hot-reload backup files
~*.dll
~*.so
~*.dylib

# Python bytecode (Blender imports lowpoly_kit.py)
__pycache__/
