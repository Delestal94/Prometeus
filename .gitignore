# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_presets.cfg

# Exported game builds (binaries, not source -- regenerate via export_presets.cfg)
/builds/

# Blender auto-backup files
*.blend1

# Godot-generated translation files
*.translation

# Imported/compiled binaries
*.import

# Mono/C# specific
.mono/
data_*/
mono_crash.*.json

# OS/editor clutter
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/

# Claude Code local settings (herramienta, no proyecto)
.claude/

# Godot's native-library hot-reload backup files
~*.dll
~*.so
~*.dylib

# Python bytecode (Blender imports lowpoly_kit.py)
__pycache__/
