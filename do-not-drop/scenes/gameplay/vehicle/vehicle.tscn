## Three extra passenger places make the enlarged crew van seat seven people
## behind the driver. They are deliberately in the front half, keeping the
## rear aisle clear for loose cargo and the shelves.
[node name="LeftSeat3Cushion" type="MeshInstance3D" parent="CargoBay"]
position = Vector3(-0.72, 0.5, 0.75)
material_override = SubResource("Material_cargo")
mesh = SubResource("Mesh_passenger_seat")

[node name="LeftSeat3EyePoint" type="Marker3D" parent="CargoBay"]
position = Vector3(-0.55, 1.0, 0.75)
rotation_degrees = Vector3(0, -90, 0)

[node name="FirstPersonCamera" parent="CargoBay/LeftSeat3EyePoint" instance=ExtResource("3_fp_camera")]

[node name="InteractionArea" type="Area3D" parent="CargoBay/LeftSeat3EyePoint"]
script = ExtResource("4_seat")
role = &"passenger"
seat_camera_path = NodePath("../FirstPersonCamera")
vehicle_path = NodePath("../../..")
prompt = "Sentarse"

[node name="InteractionShape" type="CollisionShape3D" parent="CargoBay/LeftSeat3EyePoint/InteractionArea"]
shape = SubResource("Shape_seat_interact_driver")

