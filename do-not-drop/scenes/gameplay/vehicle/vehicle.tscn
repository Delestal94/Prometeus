; Mask: environment + packages. Not players (layer 4 = bit 8): a player
; the truck is told to collide with can shove it, and a player placed even
; slightly inside it (getting out of a seat) launched the whole truck. Players
; still collide with the truck from their side (their mask includes it).
[node name="DeliveryVan" type="VehicleBody3D" groups=["vehicle"]]
collision_layer = 2
collision_mask = 5
mass = 950.0
physics_material_override = SubResource("PhysicsMaterial_body")
center_of_mass_mode = 1
center_of_mass = Vector3(0, -0.42, 0.1)
continuous_cd = true
linear_damp = 0.08
angular_damp = 0.6
can_sleep = false
script = ExtResource("1_vehicle")
controls_enabled = false

[node name="VehicleInputComponent" type="Node" parent="."]
script = ExtResource("2_input")

[node name="VehiclePresentation" type="Node3D" parent="."]
script = ExtResource("6_presentation")

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="."]
replication_interval = 0.05
replication_config = SubResource("Repl_vehicle")

; Collision follows the authored truck (assets/models/truck_reference_lowpoly.glb,
; placed by reference_truck.gd at scale 0.8, front = -Z). Everything the crew
; walks on or bumps into inside matches a visible surface: nothing invisible
; to snag on, nothing visible to walk through.
[node name="ChassisCollision" type="CollisionShape3D" parent="."]
position = Vector3(0, -0.03, 0.8)
shape = SubResource("Shape_chassis")

; Solid cab, bulkhead to bumper, following the windshield and nose profile.
