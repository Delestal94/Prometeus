#!/usr/bin/env bash
# Runs the headless test suite before every push and blocks the push if
# anything fails. Enable it once per clone with: tools/setup-hooks.sh
#
# Skipped when the commits being pushed only touch docs (nothing under
# do-not-drop/, tools/ or .github/). SKIP_TESTS=1 git push skips the tests
# (CI on GitHub still runs the suite) but not the lint nor tools/check_modules.py:
# they take a second, and a PR that CI rejects for a long line costs a routine a
# whole run (#71).
set -u

ROOT="$(git rev-parse --show-toplevel)"

# Portable modules name nothing of the game (docs/modulos.md): one second, no
# Godot. Like the lint, SKIP_TESTS doesn't skip it. On Windows "python3" can be
# the Store's stub, so only an interpreter that actually runs counts.
check_modules() {
	local py=""
	for candidate in python3 python; do
		if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "" >/dev/null 2>&1; then
			py="$candidate"; break
		fi
	done
	if [ -z "$py" ]; then
		echo "pre-push: sin Python, tools/check_modules.py queda para CI."
		return 0
	fi
	if ! "$py" "$ROOT/tools/check_modules.py"; then
		echo "pre-push: un módulo de do-not-drop/modules/ nombra algo del juego, no se sube nada."
		exit 1
	fi
}

if [ "${SKIP_TESTS:-0}" = "1" ]; then
	check_modules
	if command -v gdlint >/dev/null 2>&1 && ! bash "$ROOT/tools/lint.sh"; then
		echo "pre-push: el lint encontró problemas nuevos, no se sube nada (SKIP_TESTS no saltea el lint)."
		exit 1
	fi
	echo "pre-push: SKIP_TESTS=1, no corro los tests (CI los va a correr igual)."
	exit 0
fi
ZERO="0000000000000000000000000000000000000000"
needs_tests=0
refs=0
while read -r local_ref local_sha remote_ref remote_sha; do
	refs=$((refs + 1))
	[ "$local_sha" = "$ZERO" ] && continue  # deleting a branch
	if [ "$remote_sha" = "$ZERO" ]; then
		base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
	else
		base="$remote_sha"
	fi
	if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
		needs_tests=1; continue
	fi
	if git diff --name-only "$base" "$local_sha" | grep -qE '^(do-not-drop|tools|\.github)/'; then
		needs_tests=1
	fi
done

# Git leaves out refs it already knows it will reject (not a fast-forward):
# nothing of ours is going up, so there's nothing to check.
if [ $refs -eq 0 ]; then
	exit 0
fi

if [ $needs_tests -eq 0 ]; then
	echo "pre-push: solo cambios de documentación, no hace falta correr los tests."
	exit 0
fi

check_modules

# The lint takes a second; without gdtoolkit installed, CI still runs it.
if command -v gdlint >/dev/null 2>&1; then
	if ! bash "$ROOT/tools/lint.sh"; then
		echo "pre-push: el lint encontró problemas nuevos, no se sube nada."
		exit 1
	fi
else
	echo "pre-push: sin gdlint (pip install \"gdtoolkit==4.5.0\"), el lint queda para CI."
fi

echo "pre-push: corriendo los tests antes de subir..."
if ! bash "$ROOT/tools/run-tests.sh"; then
	echo ""
	echo "pre-push: hay tests fallando, no se sube nada. Arreglalos (o, si es urgente, SKIP_TESTS=1 git push)."
	exit 1
fi
