#!/usr/bin/env bash
# Runs the headless test suite before every push and blocks the push if
# anything fails. Enable it once per clone with: tools/setup-hooks.sh
#
# Skipped when the commits being pushed only touch docs (nothing under
# do-not-drop/, tools/ or .github/). Emergency bypass: SKIP_TESTS=1 git push
# (CI on GitHub still runs the suite).
set -u

if [ "${SKIP_TESTS:-0}" = "1" ]; then
	echo "pre-push: SKIP_TESTS=1, no corro los tests (CI los va a correr igual)."
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
needs_tests=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$ZERO" ] && continue  # deleting a branch
	if [ "$remote_sha" = "$ZERO" ]; then
		base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
	else
		base="$remote_sha"
	fi
	if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
		needs_tests=1; continue
	fi
	if git diff --name-only "$base" "$local_sha" | grep -qE '^(do-not-drop|tools|\.github)/'; then
		needs_tests=1
	fi
done

if [ $needs_tests -eq 0 ]; then
	echo "pre-push: solo cambios de documentación, no hace falta correr los tests."
	exit 0
fi

echo "pre-push: corriendo los tests antes de subir..."
if ! bash "$ROOT/tools/run-tests.sh"; then
	echo ""
	echo "pre-push: hay tests fallando, no se sube nada. Arreglalos (o, si es urgente, SKIP_TESTS=1 git push)."
	exit 1
fi
