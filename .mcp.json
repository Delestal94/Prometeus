{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "blender-mcp"
      ],
      "env": {}
    },
    "godot": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@coding-solo/godot-mcp@0.1.1"
      ],
      "env": {
        "GODOT_PATH": "${GODOT:-}"
      }
    }
  }
}
